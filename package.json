{
  "name": "tauri-app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.mermaid.config.ts && node scripts/finalize-mermaid-renderer.mjs",
    "test": "vitest run",
    "test:ci": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "audit": "npm audit --registry=https://registry.npmjs.org --audit-level=high",
    "release:check": "npm run test:ci && npm run lint && npm run build && npm run audit && node scripts/check-release.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@lezer/highlight": "1.2.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.46",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  },
  "overrides": {
    "mermaid": {
      "dompurify": "3.4.13"
    },
    "js-beautify": {
      "glob": "10.5.0"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.4"
    },
    "postcss": {
      "nanoid": "3.3.17"
    },
    "vite": {
      "postcss": "8.5.26"
    }
  }
}
